{
  "name": "VButler Video App",
  "short_name": "VButler",
  "description": "A video management app with offline support and installable PWA features.",
  "start_url": "index.html",
  "id": "/vbutler/index.html",
  "display_override": [
    "window-controls-overlay",
    "fullscreen",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "display": "fullscreen",
  "background_color": "#333",
  "theme_color": "#000",
  "orientation": "any",
  "scope": ".",
  "icons": [
    {
      "src": "img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+vbutler",
      "url": "web+vbutler://%s"
    }
  ],
  "related_applications": [
    {
        "platform": "webapp",
        "url": "manifest.json",
        "id": "https://o-ciper.github.io/vbutler/index.html"
    }
  ],
  "screenshots": [
    {
     "src": "source/vbutler-wide-1.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Home screen with video list"
    },
    {
     "src": "source/vbutler-wide-2.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Profile and video selection screen"
    },
    {
     "src": "source/vbutler-wide-3.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Profile settings screen"
    },
    {
     "src": "source/vbutler-wide-4.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Other settings screen"
    },
    {
     "src": "source/vbutler-mobile-1.jpg",
      "sizes": "1080x2340",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Home screen with video list (mobile)"
    },
    {
     "src": "source/vbutler-mobile-2.jpg",
